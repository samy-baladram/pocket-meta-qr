{
  "name": "Pocket Meta QR",
  "short_name": "Meta QR",
  "description": "This week's winning Pokémon TCG Pocket decks, with a QR code for every list.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f0f3f6",
  "theme_color": "#1aa4f9",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pocketmetaqr.com/manifest.webmanifest"
    }
  ]
}
